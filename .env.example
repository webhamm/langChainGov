# Copy to .env and fill in. .env is git-ignored.
# Key for the LiteLLM proxy. `make llm-up` starts a repo-owned proxy that uses
# LITELLM_MASTER_KEY (it must start with sk-); langchaingov accepts it as its API key.
LITELLM_MASTER_KEY=sk-your-litellm-key
# The local model `make llm-up` serves (llama3.2:3b with a 32k window).
LANGCHAINGOV_MODEL=llama3.2-3b-32k
LANGCHAINGOV_BASE_URL=http://localhost:4000/v1
LANGCHAINGOV_TEMPERATURE=0
